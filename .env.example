# Load with: set -a; source .env; set +a
DISCORD_TOKEN=
DATABASE_URL=postgresql://pippo:password@localhost:5432/pippobot_db
# Alternatively: DATABASE_NAME, DATABASE_USER, DATABASE_PASSWORD,
# DATABASE_HOST, DATABASE_PORT (default 5432).
DATABASE_POOL_SIZE=5
PRODUCTION=false
BOT_OWNER_ID=302253506947973130
LOG_LEVEL=INFO

# Optional integrations
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
# strict requires no data collection and zero data retention. Use standard only
# when you accept the selected model provider's data policy.
OPENROUTER_PRIVACY_MODE=strict
OPENROUTER_SITE_URL=https://pippo.shoonya.live
OPENROUTER_APP_NAME=Pippo
TOPGG_TOKEN=

# Optional playground/fetch_sheets.py map importer
GOOGLE_API_KEY=
GOOGLE_SHEET_ID=
